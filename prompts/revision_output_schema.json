{
  "type": "object",
  "required": [
    "revised_attribution",
    "confidence",
    "revision_decision",
    "justification",
    "evidence_affected"
  ],
  "properties": {
    "revised_attribution": {
      "type": "string",
      "enum": [
        "supported",
        "partially_supported",
        "not_supported",
        "insufficient_basis"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence in the reassessment provided, not the probability that the system is trustworthy."
    },
    "revision_decision": {
      "type": "string",
      "enum": [
        "maintain",
        "strengthen",
        "weaken",
        "withdraw"
      ]
    },
    "justification": {
      "type": "string"
    },
    "evidence_affected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
